@{
    ViewData["Title"] = "Iniciar Sesión - FilaU";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-lg border-0 rounded-3">
                <div class="card-header bg-primary text-white text-center py-3">
                    <h4 class="mb-0 fw-bold">Bienvenido a FilaU</h4>
                    <small>Sistema de Turnos Virtuales</small>
                </div>
                <div class="card-body p-4">
                    <p class="text-center text-muted mb-4">Selecciona tu rol para ingresar al sistema:</p>

                    <div class="d-grid gap-3">
                        <a asp-controller="Login" asp-action="UserLogin" class="btn btn-outline-primary btn-lg p-3 text-start shadow-sm">
                            <div class="fw-bold"> Ingresar como Estudiante</div>
                            <small class="text-muted d-block">Solicita tu turno virtual y consulta tu tiempo de espera.</small>
                        </a>

                        <a asp-controller="Login" asp-action="AdminLogin" class="btn btn-outline-dark btn-lg p-3 text-start shadow-sm">
                            <div class="fw-bold"> Ingresar como Administrador</div>
                            <small class="text-muted d-block">Atiende turnos y analiza las métricas del sistema.</small>
                        </a>
                    </div>
                </div>
                <div class="card-footer bg-light text-center py-2">
                    <small class="text-muted">Investigación de Operaciones - IUE</small>
                </div>
            </div>
        </div>
    </div>
</div>