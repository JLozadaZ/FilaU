@{
    ViewData["Title"] = "Iniciar Sesión Administrador - FilaU";
}

<!-- Estilos para el fondo con la imagen del campus de la IUE -->
<style>
    .bg-login-iue {
        background: linear-gradient(rgba(0, 0, 0, 0.65), rgba(0, 0, 0, 0.65)), 
                    url('/images/campus-iue.jpg') no-repeat center center fixed;
        background-size: cover;
        min-height: 100vh;
    }
    .card-login-custom {
        background-color: rgba(255, 255, 255, 0.95) !important;
        backdrop-filter: blur(4px);
        border-radius: 18px;
    }
</style>

<div class="bg-login-iue d-flex align-items-center justify-content-center py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-5 col-lg-4">
                <div class="card card-login-custom shadow-lg border-0 p-4">
                    <div class="text-center mb-4">
                        <span style="font-size: 2.5rem;">⚙️</span>
                        <h3 class="fw-bold text-dark mt-2">Acceso Admin</h3>
                        <small class="text-muted">Gestión de Colas y Analítica IO</small>
                    </div>

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger py-2 small text-center" role="alert">
                            @ViewBag.Error
                        </div>
                    }

                    <form asp-controller="Login" asp-action="AdminLogin" method="post">
                        <div class="mb-3">
                            <label class="form-label fw-bold small text-secondary">Correo Administrativo</label>
                            <input type="email" name="correo" class="form-control rounded-pill py-2" placeholder="admin@iue.edu.co" required />
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-bold small text-secondary">Contraseña</label>
                            <input type="password" name="password" class="form-control rounded-pill py-2" placeholder="••••••••" required />
                        </div>
                        <button type="submit" class="btn btn-dark w-100 rounded-pill py-2 fw-bold shadow-sm">
                            Ingresar al Dashboard
                        </button>
                    </form>

                    <div class="text-center mt-4">
                        <a asp-controller="Home" asp-action="Index" class="text-decoration-none small text-muted">← Volver al inicio</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>