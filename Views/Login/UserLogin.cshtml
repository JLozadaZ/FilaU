@{
    ViewData["Title"] = "Iniciar Sesión Estudiante - FilaU";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        .bg-login-iue {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background: linear-gradient(rgba(0, 0, 0, 0.55), rgba(0, 0, 0, 0.55)), 
                        url('/images/Campus.jpg') no-repeat center center;
            background-size: cover;
            z-index: 1000;
            overflow-y: auto;
        }

        .card-login-custom {
            background-color: rgba(255, 255, 255, 0.95) !important;
            backdrop-filter: blur(6px);
            border-radius: 20px;
            width: 100%;
            max-width: 420px;
        }
    </style>
</head>
<body>
    <div class="bg-login-iue d-flex align-items-center justify-content-center p-3">
        <div class="card card-login-custom shadow-lg border-0 p-4 my-auto">
            <div class="text-center mb-4">
                <span style="font-size: 2.5rem;"></span>
                <h3 class="fw-bold text-dark mt-2">Acceso Estudiante</h3>
                <small class="text-muted">Plataforma de Turnos Virtuales FilaU</small>
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger py-2 small text-center" role="alert">
                    @ViewBag.Error
                </div>
            }

            <form asp-controller="Login" asp-action="UserLogin" method="post">
                <div class="mb-3">
                    <label class="form-label fw-bold small text-secondary">Correo Institucional</label>
                    <input type="email" name="correo" class="form-control rounded-pill py-2" placeholder="ejemplo@iue.edu.co" required />
                </div>
                <div class="mb-4">
                    <label class="form-label fw-bold small text-secondary">Contraseña</label>
                    <input type="password" name="password" class="form-control rounded-pill py-2" placeholder="••••••••" required />
                </div>
                <button type="submit" class="btn btn-primary w-100 rounded-pill py-2 fw-bold shadow-sm">
                    Ingresar a FilaU
                </button>
            </form>

            <div class="text-center mt-4">
                <a asp-controller="Home" asp-action="Index" class="text-decoration-none small text-muted">← Volver al inicio</a>
            </div>
        </div>
    </div>
</body>
</html>